{
  "name": "portless-remote",
  "version": "0.1.0",
  "private": true,
  "description": "Effect-based read-only Portless observer and remote HTTPS dry-run planner",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "portless-remote": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && vitest run",
    "dev": "tsx src/cli.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm test && npm run format:check"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.112",
    "effect": "4.0.0-rc.112"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-rc.112",
    "@types/node": "24.13.3",
    "portless": "0.15.6",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  }
}
